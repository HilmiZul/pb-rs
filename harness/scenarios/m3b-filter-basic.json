{
  "name": "m3b-filter-basic",
  "requests": [
    {
      "name": "login",
      "method": "POST",
      "path": "/api/collections/_superusers/auth-with-password",
      "body": "{\"identity\": \"admin@example.com\", \"password\": \"pass12345678\"}",
      "save": {
        "token": "token"
      }
    },
    {
      "name": "create-collection",
      "method": "POST",
      "path": "/api/collections",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"type\": \"base\", \"name\": \"posts\", \"fields\": [{\"name\": \"title\", \"type\": \"text\"}, {\"name\": \"count\", \"type\": \"number\"}, {\"name\": \"active\", \"type\": \"bool\"}]}"
    },
    {
      "name": "r1",
      "method": "POST",
      "path": "/api/collections/posts/records",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"title\": \"hello\", \"count\": 5, \"active\": true}"
    },
    {
      "name": "r2",
      "method": "POST",
      "path": "/api/collections/posts/records",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"title\": \"world\", \"count\": 10, \"active\": false}"
    },
    {
      "name": "r3",
      "method": "POST",
      "path": "/api/collections/posts/records",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"title\": \"hello world\", \"count\": 5, \"active\": true}"
    },
    {
      "name": "f-eq",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=count=5",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-ne",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=count!=5",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-gt",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=count>5",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-gte",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=count>=5",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-lt",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=count<10",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-lte",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=count<=5",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-contains",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=title~'ell'",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-notcontains",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=title!~'ell'",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-and",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=count=5 && active=true",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-or",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=count=5 || count=10",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-paren",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=(count=5 || count=10) && active=true",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-null",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=title=null",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-bool",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=active=true",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-str",
      "method": "GET",
      "path": "/api/collections/posts/records?filter=title='hello'",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-sort",
      "method": "GET",
      "path": "/api/collections/posts/records?sort=-count,title",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "f-paged",
      "method": "GET",
      "path": "/api/collections/posts/records?page=1&perPage=2&sort=title",
      "headers": {
        "authorization": "{{token}}"
      }
    }
  ]
}
